{
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm install --omit=dev",
  "redirects": [
    {
      "source": "/portal",
      "destination": "/free-mock-portal",
      "permanent": false
    },
    {
      "source": "/portal.html",
      "destination": "/free-mock-portal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://student-portal-next-lilac.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://student-portal-next-lilac.vercel.app/dashboard/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://student-portal-next-lilac.vercel.app/_next/:path*"
    }
  ]
}
